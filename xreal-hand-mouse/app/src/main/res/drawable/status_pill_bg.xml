<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo "rounded-full" da status pill: surface + stroke 1dp. Raio grande (999dp) garante
     cantos totalmente arredondados independente da altura. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/hm_surface" />
    <stroke android:width="1dp" android:color="@color/hm_stroke" />
    <corners android:radius="999dp" />
</shape>
