    <string name="setup_complete_label">✓ Complete</string>
    <string name="setup_onetime_note">One-time setup — grant the requested permissions, connect the glasses, then tap Connect. Automatic connection can be enabled in Settings; its USB prompt waits a few seconds after attachment.</string>
    <string name="status_permissions_ready">Permissions OK — ready to connect the glasses</string>
    <string name="countdown_accept_usb_prompt">Accept the USB prompt now — %1$ds</string>
    <string name="accessibility_steps">1. Tap \"Open Accessibility Settings\" below\n2. Find \"XREAL Eye Tools\" in the list\n3. Enable it and confirm</string>
    <string name="section_gestures">GESTURES</string>
    <string name="gestures_list">Move hand — cursor (trackpad style)\nShort pinch or fist — tap; two short pinches — double tap\nHold pinch and move — drag\nStationary long pinch — menu; move left/up/right, then pinch to confirm\nFist in menu — cancel; hold fist 2s to recenter cursor</string>
    <string name="section_voice_commands">VOICE COMMANDS</string>
    <string name="voice_commands_list_en">Back — go back\nHome / Close — go to home screen\nRecents — open recent apps\nSend — press Enter\nClear — clear text\nOpen &lt;app name&gt; — launch an app\nWrite &lt;text&gt; — dictate text</string>
    <string name="voice_commands_list_ko">뒤로 — go back\n홈 / 닫기 — go to home screen\n최근 앱 — open recent apps\n전송 — press Enter\n모두 지우기 — clear text\n열기 &lt;앱 이름&gt; — launch an app\n쓰기 &lt;텍스트&gt; — dictate text</string>

