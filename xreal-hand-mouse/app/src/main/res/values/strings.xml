    <string name="pref_tracking_enabled_sum">Off = recording-only mode: no decoding, no MediaPipe (coolest, lowest battery)</string>
    <string name="pref_cursor_sensitivity">Cursor sensitivity (%)</string>
    <string name="pref_cursor_sensitivity_sum">100 = default. Higher = less hand movement per screen width</string>
    <string name="pref_pinch_sensitivity">Pinch sensitivity</string>
    <string name="pref_pinch_sensitivity_sum">50 = default. Higher = pinch registers earlier (more false clicks); lower = fingers must touch firmly</string>
    <string name="pref_smoothing">Smoothing</string>
    <string name="pref_smoothing_sum">50 = default. Higher = steadier but laggier cursor</string>
    <string name="pref_dead_zone">Dead-zone (0.1 px)</string>
    <string name="pref_dead_zone_sum">15 = 1.5 px. Suppresses micro-jitter while holding still</string>
    <string name="pref_pinch_hold">Pinch hold → drag (ms)</string>
    <string name="pref_pinch_hold_sum">Pinch shorter than this = click, longer = drag</string>
    <string name="pref_click_debounce">Click debounce (frames)</string>
    <string name="pref_click_debounce_sum">Frames a pinch must persist before it counts (3 ≈ 50 ms at 60 fps)</string>
    <string name="pref_ignore_bottom">Ignore hands low in the camera view (%)</string>
    <string name="pref_ignore_bottom_sum">0 = off. Riding: 30–40 so hands on the handlebars never click</string>
    <string name="pref_world_pinch">3D pinch detection</string>
    <string name="pref_world_pinch_sum">Uses MediaPipe metric 3D landmarks — fewer false clicks when the hand is turned sideways</string>
