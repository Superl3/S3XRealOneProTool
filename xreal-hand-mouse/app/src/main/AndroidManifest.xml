<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.usb.host" android:required="true"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <!-- Controle por voz (2026-07-23): mic pro SpeechRecognizer; o FGS type microphone permite
         a escuta com o app em background (a janela abre por gesto, com qualquer app na frente) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.CAMERA"/> <!-- pré-condição do grant USB p/ classe vídeo -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Tarefa 5: notificação full-screen-intent na desconexão USB (PLANO.md Fase 5) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- Glasses IMU (2026-09-29): TCP to the glasses' USB network 169.254.2.1:52998, found via
         ConnectivityManager (imu/XrealImuClient.kt) -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Recording enhancer (2026-09-29): mediaProcessing needs API 35, dataSync covers 34 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING"/>

    <!-- Visibilidade de pacotes (fix de revisão final 2026-07-23): com targetSdk 30+, sem esta
         declaração o queryIntentActivities do AppLauncher só enxerga pacotes auto-visíveis —
         "abrir <app>" falharia pra maioria dos apps de terceiros. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.HandMouse">
        <!-- Theme.HandMouse (parent Theme.Material3.Dark.NoActionBar): dark cockpit da UI
             "painel de instrumentos AR". Material3 também descende (via a material lib) da
             cadeia Theme.AppCompat, então MainActivity continua AppCompatActivity e o
             setContentView não lança IllegalStateException (o motivo do crash com
             @android:Theme.Material antes de existir este tema). -->


        <service
            android:name=".service.RecordTileService"
            android:exported="true"
            android:icon="@android:drawable/presence_video_online"
            android:label="@string/tile_record"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE"/></intent-filter>
        </service>
        <service
            android:name=".service.PhotoTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_camera"
            android:label="@string/tile_photo"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE"/></intent-filter>
        </service>

        <service android:name=".service.EyeCaptureService" android:exported="false"
                 android:foregroundServiceType="connectedDevice|microphone"/>

        <service android:name=".enhance.EnhanceService" android:exported="false"
                 android:foregroundServiceType="dataSync|mediaProcessing"/>

        <service
            android:name=".service.HandMouseAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config"/>
        </service>

        <!-- Eye Tools fork: invisible target for app shortcuts / assistant / deep links -->
        <activity
            android:name=".ActionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="xreal-eye" android:host="action"/>
            </intent-filter>
        </activity>

        <activity android:name=".SettingsActivity" android:exported="false"
                  android:parentActivityName=".MainActivity"/>

        <activity android:name=".MainActivity" android:exported="true"
                  android:launchMode="singleTop"
                  android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
            <intent-filter><action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"/></intent-filter>
            <meta-data android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                       android:resource="@xml/usb_device_filter"/>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts"/>
        </activity>

    </application>
</manifest>
